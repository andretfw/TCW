# Public site URL
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Dream Support application service
# Generate separate random values. Never commit real values.
DREAM_APPLICATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# New encrypted records include this key id. Existing deployments may keep
# "legacy" until the first planned rotation.
DREAM_APPLICATION_ENCRYPTION_KEY_ID=legacy
# JSON map of older key ids to their 32-byte keys. During the first rotation,
# keep the old DREAM_APPLICATION_ENCRYPTION_KEY here under "legacy" so all
# existing Dream, Connect, reviewer-session, and Google Workspace records stay readable.
DREAM_APPLICATION_ENCRYPTION_PREVIOUS_KEYS={}
# Keep this independent from encryption keys so rotation does not change
# rate-limit, access-token, or session lookup hashes.
DREAM_RATE_LIMIT_SALT=replace-with-a-separate-random-value
DREAM_ADMIN_EMAILS=replace-with-authorized-reviewer-email

# Private Google Shared Drive document storage
# Keep the client secret and the encrypted refresh token private.
GOOGLE_DRIVE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=replace-with-private-upload-folder-id
GOOGLE_DRIVE_ACCOUNT_EMAIL=replace-with-authorized-drive-account-email
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://your-domain.example/api/google-drive/oauth/callback

# Existing donation service variables are configured separately in Netlify.
