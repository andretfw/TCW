# Public site URL
NEXT_PUBLIC_SITE_URL=https://tutticancerwarriors.org

# Dream Support application service
# Generate separate random values. Never commit real values.
DREAM_APPLICATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
DREAM_RATE_LIMIT_SALT=replace-with-a-separate-random-value
DREAM_ADMIN_EMAILS=tcw@tutticancerwarriors.org

# Private Google Shared Drive document storage
# Keep the client secret and the encrypted refresh token private.
GOOGLE_DRIVE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=replace-with-dream-application-uploads-folder-id
GOOGLE_DRIVE_ACCOUNT_EMAIL=tcw@tutticancerwarriors.org
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://tutticancerwarriors.org/api/google-drive/oauth/callback

# Existing donation service variables are configured separately in Netlify.
