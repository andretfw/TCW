      "vaginal": {
        "title": "Vaginal Cancer",
        "shortDesc": "A rare cancer that begins in the vagina, most commonly in squamous cells lining its surface."
      },
      "vulvar": {
        "title": "Vulvar Cancer",
        "shortDesc": "Cancer that begins on the external female genital tissues and may appear as persistent itching, pain or skin changes."
      },
      "eye": {
        "title": "Eye Cancer",
        "shortDesc": "A group of rare cancers affecting the eye, including uveal melanoma in adults and retinoblastoma in children."
      },
      "oral": {
        "title": "Oral Cancer",
        "shortDesc": "Cancer that begins in the lips or oral cavity, including the tongue, gums, inner cheeks and floor or roof of the mouth."
      },
      "throat": {
        "title": "Throat Cancer",
        "shortDesc": "An informal term for cancers that arise in parts of the pharynx or larynx, each with distinct risks and treatments."
      },
      "small-intestine": {
        "title": "Small Intestine",
        "shortDesc": "A rare group of cancers that begin in the small intestine, including adenocarcinoma, neuroendocrine tumours, lymphoma and sarcoma."
      },
      "thymus": {
        "title": "Thymus Cancer",
        "shortDesc": "Rare tumours that begin in the thymus behind the breastbone, mainly thymoma and thymic carcinoma."
      }
    }
  },
  "diagnosisPage": {
    "title": "Understanding Your Diagnosis",
    "heroDesc": "Navigating a cancer diagnosis can be overwhelming. We are here to help you make sense of the medical terms, staging, and next steps.",
    "whatIsCancerTitle": "What is Cancer?",
    "whatIsCancerDesc": "Cancer is a group of diseases involving abnormal cell growth with the potential to invade or spread to other parts of the body. Understanding the basics is the first step in taking control.",
    "stagingTitle": "Staging",
    "stagingSub": "Understanding the Spread",
    "stagingDesc": "Staging describes the extent of cancer in the body. It is usually based on the size of the tumor, whether lymph nodes contain cancer, and whether the cancer has spread from the original site.",
    "stages": {
      "0": "Abnormal cells present but have not spread.",
      "I": "Cancer is small and contained.",
      "II": "Cancer has grown but is still localized.",
      "III": "Cancer has spread to nearby lymph nodes.",
      "IV": "Cancer has spread to other parts of the body."
    },
    "gradingTitle": "Grading",
    "gradingDesc": "Grading describes how the cancer cells look compared to normal cells. It gives an idea of how quickly the cancer may grow and spread.",
    "aloneTitle": "You Are Not Alone",
    "aloneDesc": "Receiving a diagnosis is just the start of your journey as a warrior. Our community is here to support you, listen to you, and fight alongside you.",
