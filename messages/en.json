  "grantPolicy": {
    "title": "Tutti Cancer Warriors Grant Policy",
    "header": {
      "effectiveDate": "Effective date: 29 July 2026",
      "version": "Policy version: 3.1"
    },
    "sections": {
      "mission": "Mission and Eligibility",
      "scope": "Purpose and Grant Process",
      "legislation": "Governance, Evidence and Privacy",
      "disputes": "Misuse, Disputes and Force Majeure"
    },
    "fullContent": {
      "missionText": "Asociația Tutti Cancer Warriors (TCW) supports the emotional and practical well-being of adults affected by cancer. An applicant must be at least 18, provide acceptable verification of a cancer diagnosis, and be in a country where TCW can lawfully and operationally provide support. Each application is assessed individually by TCW; applying does not guarantee approval.",
      "scopeIntro": "An approved grant supports a non-medical personal wish with a value of up to €500. TCW does not fund medical treatment or medication. The approved purpose, amount, method and conditions are recorded in the grant agreement.",
      "wishesTitle": "Approval and fulfilment",
      "wishesText": "A wish may include an appropriate experience, item or well-being activity. Subject to the agreement, TCW may buy the item or service directly, pay a supplier, reimburse approved documented costs, or transfer funds to the beneficiary. Support is normally fulfilled within 30 days after approval is complete, the required funds are available and all agreement conditions have been met.",
      "nonTransferableTitle": "Personal and non-transferable",
      "nonTransferableText": "Support is only for the named beneficiary and approved wish. It may not be transferred, sold or used for a different purpose without TCW’s written approval.",
      "adminCostsTitle": "Value and availability",
      "adminCostsText": "The maximum value is €500, not a guaranteed fixed payment. The final value may be lower and depends on the approved wish, available funds, lawful payment options and the signed agreement.",
      "legalBasisTitle": "Legal and organisational basis",
      "legalBasisText": "TCW is a Romanian nonprofit association operating under Government Ordinance no. 26/2000, approved and amended by Law no. 246/2005, its Statute and other applicable law. Cross-border support remains subject to sanctions, payment and local legal restrictions.",
      "financeTitle": "Records and proof of use",
      "financeText": "The beneficiary must provide the evidence specified in the agreement, such as receipts or supplier confirmation, within 3 months after the support is fulfilled or funds are received. TCW keeps financial and grant records for the periods required by applicable law.",
      "auditTitle": "Review and clarification",
      "auditText": "TCW reviews submitted proof within 15 calendar days after receiving it. If evidence is incomplete, TCW may request reasonable clarification or replacement documents and will record the outcome. Medical and supporting documents are kept confidential with access limited to authorised persons.",
      "gdprTitle": "Data and publicity",
      "gdprText": "Personal data is processed under the Privacy Notice and GDPR. Health data requires an applicable Article 9 basis, normally explicit consent. Permission to publish a name, story, image or campaign is separate, optional and does not affect eligibility; anonymity is available.",
      "crossBorderTitle": "Payments and tax",
      "crossBorderText": "TCW selects a lawful and practical fulfilment method. Beneficiaries are responsible for checking any personal tax or reporting duties in their country; TCW does not provide tax advice.",
      "disputesText": "Concerns should first be raised with TCW so the parties can seek a fair, documented solution. Romanian law applies without removing mandatory rights under other applicable law. Any unresolved dispute is handled by the competent courts unless the grant agreement lawfully provides otherwise.",
      "terminationText": "Fraud, material misrepresentation, transfer or misuse of support, or unjustified failure to provide agreed proof may lead to suspension, termination or a proportionate repayment request after notice and an opportunity to explain. TCW may waive or adjust a remedy where serious illness or hardship makes that fair and lawful.",
      "forceMajeureTitle": "Force majeure and extensions",
      "forceMajeureText": "If serious illness, force majeure or another event outside the beneficiary’s reasonable control prevents timely fulfilment or proof, TCW may approve a written extension of up to 6 months. The beneficiary should contact TCW as soon as reasonably possible."
    }
  }
}
