    "sections": {
      "anxiety": {
        "title": "Manejo de la Ansiedad",
        "tech1_name": "Respiración Profunda",
        "tech1_steps": [
          "Busca un lugar tranquilo, siéntate o túmbate cómodamente",
          "Cierra los ojos e inhala lenta y profundamente por la nariz",
          "Deja que tu abdomen se eleve, mantén el aire unos segundos",
          "Exhala lentamente por la boca",
          "Repite varias veces, concentrándote en la sensación de respirar"
        ],
        "tech2_name": "Respiración 4-7-8",
        "tech2_steps": [
          "Inhala por la nariz contando hasta 4",
          "Mantén la respiración contando hasta 7",
          "Exhala por la boca contando hasta 8",
          "Esto ayuda a ralentizar la respiración y es efectivo antes de dormir"
        ],
        "tech3_name": "Desafiar Pensamientos Negativos",
        "tech3_steps": [
          "Cuando aparezcan pensamientos ansiosos, identifícalos y desafíalos",
          "Pregúntate si se basan en hechos o en suposiciones",
          "Reemplaza los pensamientos negativos por otros realistas y equilibrados"
        ],
        "tech4_name": "Práctica de Mindfulness",
        "tech4_steps": [
          "Concéntrate en el momento presente en lugar de preocuparte por el futuro",
