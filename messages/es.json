    "lung": {
      "title": "Cáncer de Pulmón",
      "shortDescription": "El cáncer que comienza en los pulmones. Es la principal causa de muerte por cáncer en todo el mundo.",
      "overviewTitle": "¿Qué es el Cáncer de Pulmón?",
      "overviewText": "Se forma en los tejidos de los pulmones, generalmente en las células que recubren los conductos de aire. Los dos tipos principales son el cáncer de pulmón de células pequeñas y el de células no pequeñas. Fumar es el principal factor de riesgo.",
      "symptomsTitle": "Síntomas Comunes",
      "symptoms": {
        "symptom1": "Una tos persistente que no desaparece o empeora.",
        "symptom2": "Tos con sangre o esputo color óxido.",
        "symptom3": "Dolor en el pecho que empeora al respirar profundo o toser.",
        "symptom4": "Ronquera persistente.",
        "symptom5": "Pérdida de peso y apetito sin causa aparente.",
        "symptom6": "Dificultad para respirar o sibilancias."
      },
