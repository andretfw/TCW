    "prostate": {
      "title": "Cáncer de Próstata",
      "shortDescription": "Cáncer que se forma en la glándula prostática de los hombres.",
      "overviewTitle": "Entendiendo el Cáncer de Próstata",
      "overviewText": "Es uno de los tipos de cáncer más comunes en los hombres. Generalmente crece lentamente y se limita a la glándula prostática, donde puede no causar daños graves. Sin embargo, algunos tipos son agresivos y pueden propagarse rápidamente.",
      "symptomsTitle": "Síntomas (Avanzado)",
      "symptoms": {
        "symptom1": "Problemas para orinar o flujo de orina débil.",
        "symptom2": "Necesidad de orinar con frecuencia, especialmente de noche.",
        "symptom3": "Sangre en la orina o en el semen.",
        "symptom4": "Dificultad para lograr una erección (disfunción eréctil).",
        "symptom5": "Dolor en las caderas, la espalda o el tórax (si se ha propagado).",
        "symptom6": "Debilidad o adormecimiento en las piernas."
      },
      "treatmentsTitle": "Opciones de Manejo",
      "treatmentsIntro": "El tratamiento varía desde la vigilancia activa (para cánceres de bajo riesgo) hasta intervenciones más agresivas.",
      "treatment1": {
        "title": "Vigilancia Activa",
        "desc": "Monitoreo cercano del cáncer sin tratamiento inmediato si crece muy lentamente."
      },
      "treatment2": {
        "title": "Cirugía y Radioterapia",
