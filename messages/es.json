  "cancerDetails": {
    "breast": {
      "title": "Cáncer de Mama",
      "shortDescription": "El cáncer de mama ocurre cuando las células de la mama crecen sin control. Es el cáncer más común en mujeres.",
      "overviewTitle": "¿Qué es el Cáncer de Mama?",
      "overviewText": "El cáncer de mama es una enfermedad en la cual las células de la mama se multiplican sin control. Existen distintos tipos de cáncer de mama dependiendo de qué células se vuelven cancerosas (conductos o lobulillos). La detección temprana mediante mamografías es clave para la supervivencia.",
      "symptomsTitle": "Síntomas Comunes",
      "symptoms": {
        "symptom1": "Un bulto nuevo en la mama o la axila.",
        "symptom2": "Aumento del grosor o hinchazón de una parte de la mama.",
        "symptom3": "Irritación o hundimientos en la piel.",
        "symptom4": "Enrojecimiento o descamación en la zona del pezón.",
        "symptom5": "Hundimiento del pezón o dolor en esa zona.",
        "symptom6": "Cualquier cambio en el tamaño o la forma de la mama."
      },
      "treatmentsTitle": "Tratamientos y Cuidados",
      "treatmentsIntro": "El tratamiento es altamente personalizado y depende de la etapa, localización y características biológicas del tumor.",
