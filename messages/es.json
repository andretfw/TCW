    "colorectal": {
      "title": "Cáncer Colorrectal",
      "shortDescription": "Cáncer que afecta al colon o al recto, a menudo comenzando como pólipos.",
      "overviewTitle": "Resumen del Cáncer Colorrectal",
      "overviewText": "La mayoría de los cánceres colorrectales comienzan como un crecimiento en el revestimiento interno del colon o recto llamado pólipo. Con el tiempo, algunos pólipos pueden convertirse en cáncer. Las pruebas de detección regulares son vitales para la prevención.",
      "symptomsTitle": "Señales de Alerta",
      "symptoms": {
        "symptom1": "Cambio persistente en los hábitos intestinales (diarrea o estreñimiento).",
        "symptom2": "Sangrado rectal o sangre en las heces.",
        "symptom3": "Malestar abdominal persistente (calambres, gases o dolor).",
        "symptom4": "Sensación de que el intestino no se vacía por completo.",
        "symptom5": "Debilidad o fatiga inexplicables.",
        "symptom6": "Pérdida de peso sin intentarlo."
      },
      "treatmentsTitle": "Enfoque Terapéutico",
