{
  "name": "tutti-cancer-warriors",
  "version": "1.0.0",
  "private": true,
  "description": "Official multilingual website for Tutti Cancer Warriors NGO (English, Romanian and Spanish)",
  "scripts": {
    "dev": "npm exec --yes --package=netlify-cli@26.2.0 -- netlify dev",
    "dev:next": "next dev",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "npm run lint && next build",
    "start": "next start",
    "lint": "eslint .",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.12.2 <23"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.10",
    "@netlify/identity": "^1.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.454.0",
    "next": "16.2.12",
    "next-intl": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.53.2",
    "stripe": "^17.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
